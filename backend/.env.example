# Port configuration (default is 5000)
PORT=5000

# Secret key for JWT signing
SECRET_KEY=travelbuddy_secret_2025

# Enable local reset link and registration OTP fallback (bypasses email delivery constraints)
ALLOW_RESET_LINK_FALLBACK=true

# Optional Database configurations
# If postgres is not set up, SQLite (travelbuddy.db) will be used automatically.
# DATABASE_URL=postgresql://user:pass@host:port/dbname
# DATABASE_URL_POOLER=

# Optional Email settings (SendGrid or Gmail SMTP fallback)
# SENDGRID_API_KEY=your_sendgrid_api_key
# SENDGRID_FROM_EMAIL=your_verified_from_email
# GMAIL_USER=your_gmail_username@gmail.com
# GMAIL_APP_PASSWORD=your_gmail_app_password
